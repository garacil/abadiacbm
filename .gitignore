# recordings, test outputs, local environments
/src/c64/video/grabaciones/
/src/c64/video/activa.json
*.wav
/data/.venv/
/data/pruebas/salida_*/
# third-party tools (README: how to get them)
/tools/terceros/
# not part of the project's sources
/old/
/respaldos/
/reorganiza.log
